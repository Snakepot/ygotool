# 复制为 .env 并按需修改。阶段 1/2 不需要 LLM，可不填 LLM_*。

# ygocdb 基础地址（一般无需改）
YGOCDB_BASE=https://ygocdb.com

# 本地缓存目录（卡池 zip / sqlite / 向量库 都放这里）
CACHE_DIR=./cache

# ---- LLM（OpenAI 兼容接口）阶段 3+ 需要 ----
# 兼容 DeepSeek/Kimi/智谱GLM/本地 vLLM 等，base_url 指到各自 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embedding 模型 ----
# 走 LLM_BASE_URL 的 /embeddings；或留空走本地 sentence-transformers
EMBED_MODEL=
EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ---- 默认推理参数（可在 agent 调用时覆盖，用于学习对比）----
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=1024
DEFAULT_MAX_CONTEXT_TOKENS=6000
